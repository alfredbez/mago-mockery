{
    "name": "alfredbez/mago-mockery",
    "description": "Mockery support for the Mago static analyzer.",
    "type": "library",
    "license": "MIT",
    "homepage": "https://github.com/alfredbez/mago-mockery",
    "keywords": ["mago", "mockery", "static-analysis", "extension", "php"],
    "authors": [
        {
            "name": "Alfred Bez",
            "homepage": "https://github.com/alfredbez"
        }
    ],
    "support": {
        "issues": "https://github.com/alfredbez/mago-mockery/issues",
        "source": "https://github.com/alfredbez/mago-mockery"
    },
    "require": {
        "php": "~8.1.0 || ~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0 || ~8.6.0",
        "ext-tokenizer": "*",
        "carthage-software/mago": "^1.60.2"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "AlfredBez\\MagoMockery\\": "src/"
        }
    },
    "bin": [
        "bin/mago-mockery-worker"
    ],
    "scripts": {
        "test": [
            "@test:analyzer",
            "@test:runtime"
        ],
        "test:analyzer": "php tests/run.php",
        "test:runtime": "vendor/bin/phpunit tests/runtime",
        "test:syntax": "find src bin -name '*.php' -print0 | xargs -0 -n1 php -l"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": true
    }
}
