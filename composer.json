{
    "name": "alfredbez/mago-mockery",
    "description": "Mockery support for the Mago static analyzer.",
    "type": "library",
    "license": "MIT",
    "keywords": ["mago", "mockery", "static-analysis", "extension"],
    "require": {
        "php": "~8.1.0 || ~8.2.0 || ~8.3.0 || ~8.4.0 || ~8.5.0 || ~8.6.0",
        "carthage-software/mago": "1.60.2"
    },
    "require-dev": {
        "mockery/mockery": "^1.6",
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "AlfredBez\\MagoMockery\\": "src/"
        }
    },
    "scripts": {
        "test": [
            "@test:analyzer",
            "@test:runtime"
        ],
        "test:analyzer": "php tests/run.php",
        "test:runtime": "vendor/bin/phpunit tests/runtime"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": true
    }
}
